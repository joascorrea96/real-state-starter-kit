{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "real-state": {
      "projectType": "application",
      "root": "apps/real-state",
      "sourceRoot": "apps/real-state/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/apps/real-state",
            "index": "apps/real-state/src/index.html",
            "browser": "apps/real-state/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "apps/real-state/tsconfig.app.json",
            "assets": [],
            "styles": [
              "libs/core-ui/src/styles/_tokens.scss",
              "apps/real-state/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
                { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "20kb" }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/real-state/src/environments/environment.ts",
                  "with": "apps/real-state/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "real-state:build:production" },
            "development": { "buildTarget": "real-state:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "real-state-public": {
      "projectType": "application",
      "root": "apps/real-state-public",
      "sourceRoot": "apps/real-state-public/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/apps/real-state-public",
            "index": "apps/real-state-public/src/index.html",
            "browser": "apps/real-state-public/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/real-state-public/tsconfig.app.json",
            "assets": [],
            "styles": [
              "libs/core-ui/src/styles/_tokens.scss",
              "apps/real-state-public/src/styles.scss"
            ],
            "scripts": [],
            "server": "apps/real-state-public/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "apps/real-state-public/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
                { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "20kb" }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/real-state-public/src/environments/environment.ts",
                  "with": "apps/real-state-public/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "real-state-public:build:production" },
            "development": { "buildTarget": "real-state-public:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
