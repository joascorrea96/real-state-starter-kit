<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Api</RootNamespace>
    <UserSecretsId>web-systems-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <!-- Free, no external service required — hashes passwords locally -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Required directly in the STARTUP project for `dotnet ef` commands
         to work — Core.Infrastructure already references this too (with
         PrivateAssets="all"), but that setting deliberately stops it from
         flowing transitively into Api, so the EF tools can't find it
         unless it's referenced here as well. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Domain\Core.Domain.csproj" />
    <ProjectReference Include="..\Core.Application\Core.Application.csproj" />
    <ProjectReference Include="..\Core.Infrastructure\Core.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules.RealState\Modules.RealState.csproj" />
  </ItemGroup>

</Project>
